[run]
# don’t require branch coverage yet
branch = False

# only look at our library code
source = 
    src

# omit all the wrapper/entrypoint modules
omit = 
    src/cli.py
    src/download.py
    src/paper.py
    src/scheduler.py

[report]
# allow down to 75% statement coverage
fail_under = 75

# don’t count these lines
exclude_lines =
    pragma: no cover
    if __name__ == ['"]__main__['"]:
